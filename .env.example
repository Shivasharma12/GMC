# ============================================================
# GMC Extractor - environment configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# LLM provider: "gemini", "openai", "ollama", or "mock"
LLM_PROVIDER=gemini

# Gemini settings (only needed when LLM_PROVIDER=gemini)
GEMINI_API_KEY=
# Recommended Flash-Lite model: gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI settings (only needed when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama settings (only needed when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=

# Rate limiting
REQUESTS_PER_MINUTE=10
MAX_REQUESTS_PER_RUN=60

# Cache directory (relative to project root)
CACHE_DIR=.cache

# Logging verbosity: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
